<section>
    @foreach (var package in packageDetails)
    {
        <Card Title="@package.Name">
            <Content>@package.Description</Content>
            <Footer>
                <BrandLink Brand="Brand.NuGet" Href="@package.NuGetUrl">NuGet</BrandLink>
                <span class="spacer">•</span>
                <BrandLink Brand="Brand.GitHub" Href="@package.GitHubUrl">GitHub</BrandLink>
            </Footer>
        </Card>
    }
</section>
